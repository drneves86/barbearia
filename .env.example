# Supabase (projeto em https://supabase.com -> Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chaves novas (sb_publishable_* / sb_secret_*) substituem as legadas anon/service_role.
# O app usa a secret key apenas no servidor. A publishable não é usada neste projeto.
SUPABASE_SECRET_KEY=sb_secret_SUA_CHAVE

# URL pública do app (usada nos links de cancelamento enviados via WhatsApp)
BASE_URL=http://localhost:3000

# Nome da barbearia aparece em lib/config.ts (BARBERSHOP_NAME)

# Segredos do painel admin
ADMIN_SECRET=troque-por-uma-frase-longa-e-aleatoria
# Chave usada UMA vez para criar o primeiro administrador via POST /api/admin/init
ADMIN_SETUP_KEY=troque-por-outra-chave-aleatoria
